---
import Base from '../layouts/Base.astro';
import {works,copy,type Lang} from '../data/content';
export function getStaticPaths(){return [{params:{lang:'cs'}},{params:{lang:'de'}}]}
const lang=Astro.params.lang as Lang;
const other:Lang=lang==='cs'?'de':'cs';
const t=copy[lang];
const featured=works[6];
const prague=works.filter(w=>w.collection==='prague');
const still=works.filter(w=>w.collection==='still');
---
<Base lang={lang} title={`Věra Krupičková — ${t.works}`} description={t.heroSub}>
<a class="sr-only" href="#main">{t.skip}</a>
<header class="header shell"><a class="brand" href={`/${lang}/`}>VĚRA KRUPIČKOVÁ</a><nav aria-label="Navigation"><a href="#top">{t.home}</a><a href="#collections">{t.works}</a><a href="#about">{t.about}</a><a href="#contact">{t.contact}</a></nav><div class="langs"><a class={lang==='cs'?'selected':''} href="/cs/">CZ</a><span>/</span><a class={lang==='de'?'selected':''} href="/de/">DE</a></div></header>
<main id="main">
<section class="hero" id="top"><div class="hero-image"><img src={featured.image} width="504" height="640" fetchpriority="high" alt={`${featured[lang]} — Věra Krupičková`}/></div><div class="hero-wash"></div><div class="hero-copy shell"><p class="label">{t.eyebrow}</p><h1 class="serif">Věra<br/>Krupičková</h1><div class="hero-bottom"><p class="serif">{t.heroSub}</p><a class="arrow-link label" href="#collections">{t.explore}<span aria-hidden="true">↗</span></a></div></div><div class="hero-foot shell"><span class="label">01 / 13</span><span class="hero-credit"><strong>{featured.de}</strong><br/>{featured.cs} · {featured.dimensions}</span></div></section>
<section class="intro shell" id="collections"><div class="intro-head"><span class="label">01 / {t.collection}</span><span class="label muted">{t.number}</span></div><h2 class="serif">{lang==='cs'?'Dva světy. Jedna malířka.':'Zwei Welten. Eine Malerin.'}</h2><div class="collection-grid"><a href="#prague" class="collection-card"><img src="/images/prague-4.jpg" width="582" height="640" loading="lazy" alt={t.prague}/><span class="collection-overlay"><span class="label">01 — 07</span><strong class="serif">{t.prague}</strong><small>{t.pragueSub} <span aria-hidden="true">↗</span></small></span></a><a href="#still" class="collection-card"><img src="/images/work-003.jpg" width="564" height="640" loading="lazy" alt={t.still}/><span class="collection-overlay"><span class="label">08 — 13</span><strong class="serif">{t.still}</strong><small>{t.stillSub} <span aria-hidden="true">↗</span></small></span></a></div></section>
<section class="catalog shell" id="prague"><div class="catalog-head"><div><span class="label">02 / {t.index}</span><h2 class="serif">{t.prague}<span class="count">(07)</span></h2></div><p class="label muted">{t.pragueSub}</p></div><div class="art-grid">{prague.map((w,i)=><button class:list={['art-card',i===0?'offset':'']} type="button" data-work={works.indexOf(w)} aria-label={`${t.work}: ${w[lang]}`}><span class="art-picture"><img src={w.image} loading="lazy" width="560" height="640" alt={w[lang]}/></span><span class="art-info"><span class="label muted">{w.id}</span><span><strong class="serif">{w[lang]}</strong><small>{w[other]}</small></span><span class="label muted">{w.dimensions}</span></span></button>)}</div></section>
<section class="interlude"><div class="interlude-image"><img src="/images/work-001.jpg" loading="lazy" width="560" height="640" alt={works[8][lang]}/></div><div class="interlude-copy"><span class="label">VĚRA KRUPIČKOVÁ</span><p class="serif">{lang==='cs'?'Barva. Vzpomínka. Okamžik.':'Farbe. Erinnerung. Augenblick.'}</p><span class="label muted">{t.stillSub}</span></div></section>
<section class="catalog shell" id="still"><div class="catalog-head"><div><span class="label">03 / {t.index}</span><h2 class="serif">{t.still}<span class="count">(06)</span></h2></div><p class="label muted">{t.stillSub}</p></div><div class="art-grid">{still.map((w,i)=><button class:list={['art-card',i===0?'offset':'']} type="button" data-work={works.indexOf(w)} aria-label={`${t.work}: ${w[lang]}`}><span class="art-picture"><img src={w.image} loading="lazy" width="560" height="640" alt={w[lang]}/></span><span class="art-info"><span class="label muted">{w.id}</span><span><strong class="serif">{w[lang]}</strong><small>{w[other]}</small></span><span class="label muted">{w.dimensions}</span></span></button>)}</div></section>
<section class="about" id="about"><div class="about-visual"><img src="/images/prague-3.jpg" loading="lazy" width="520" height="640" alt={works[2][lang]}/></div><div class="about-text"><span class="label">04 / {t.about}</span><h2 class="serif">{t.aboutTitle}</h2><p>{t.aboutText}</p><p>{t.aboutStudy}</p><p class="about-note">{t.aboutNote}</p><a class="arrow-link label" href="#contact">{t.contact}<span aria-hidden="true">↗</span></a></div></section>
<section class="contact shell" id="contact"><div class="contact-left"><span class="label">05 / {t.contact}</span><h2 class="serif">{t.contactTitle}</h2><p>{t.contactText}</p></div><form name="vera-contact" method="POST" action={`/${lang}/?sent=1#contact`} data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="vera-contact"/><p class="sr-only"><label>Leave empty <input name="bot-field"/></label></p><label>{t.name}<input name="name" type="text" autocomplete="name" required/></label><label>{t.email}<input name="email" type="email" autocomplete="email" required/></label><label>{t.message}<textarea name="message" rows="3" required></textarea></label><button class="submit label" type="submit">{t.send}<span aria-hidden="true">↗</span></button><p class="success" id="success" hidden>{t.thanks}</p></form></section>
</main><footer class="footer shell"><strong>VĚRA KRUPIČKOVÁ</strong><span>© {new Date().getFullYear()} · {t.copyright}</span><a class="label" href="#top">↑ TOP</a></footer>
<dialog id="viewer" aria-label={t.work}><button type="button" class="close" aria-label={t.close}>×</button><div class="viewer-grid"><div class="viewer-image"><img id="viewer-img" src={featured.image} alt=""/></div><div class="viewer-text"><span class="label" id="viewer-index"></span><h2 class="serif" id="viewer-title"></h2><p id="viewer-other"></p><div class="viewer-bottom"><span class="label muted" id="viewer-size"></span><div class="viewer-buttons"><button id="prev" type="button" aria-label={t.previous}>←</button><button id="next" type="button" aria-label={t.next}>→</button></div></div></div></div></dialog>
<script define:vars={{works,lang,other}}>
 const viewer=document.querySelector('#viewer');let current=0;
 function update(i){current=(i+works.length)%works.length;const w=works[current];document.querySelector('#viewer-img').src=w.image;document.querySelector('#viewer-img').alt=w[lang];document.querySelector('#viewer-index').textContent=w.id+' / '+works.length;document.querySelector('#viewer-title').textContent=w[lang];document.querySelector('#viewer-other').textContent=w[other];document.querySelector('#viewer-size').textContent=w.dimensions;}
 document.querySelectorAll('[data-work]').forEach(b=>b.addEventListener('click',()=>{update(Number(b.dataset.work));viewer.showModal()}));document.querySelector('.close').addEventListener('click',()=>viewer.close());document.querySelector('#prev').addEventListener('click',()=>update(current-1));document.querySelector('#next').addEventListener('click',()=>update(current+1));viewer.addEventListener('click',e=>{if(e.target===viewer)viewer.close()});viewer.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')update(current-1);if(e.key==='ArrowRight')update(current+1)});if(new URLSearchParams(location.search).has('sent'))document.querySelector('#success').hidden=false;
</script>
</Base>
<style>
.header{height:78px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand,.footer strong{font-size:clamp(11px,.75vw,15px);font-weight:700;letter-spacing:.12em;white-space:nowrap}.header nav{display:flex;gap:clamp(18px,2.3vw,52px)}.header nav a,.langs{font-size:11px;font-weight:600}.header nav a:hover,.langs a:hover{opacity:.55}.langs{display:flex;gap:12px}.langs a:not(.selected){color:#a09f9a}.hero{height:clamp(680px,calc(100svh - 78px),1200px);min-height:640px;position:relative;overflow:hidden;background:#eeeae2}.hero-image{position:absolute;inset:0 0 0 32%;overflow:hidden}.hero-image img{width:100%;height:100%;object-fit:cover;object-position:center 52%}.hero-wash{position:absolute;inset:0;background:linear-gradient(90deg,#f7f6f2 0%,#f7f6f2 22%,#f7f6f2e8 33%,#f7f6f255 47%,transparent 65%)}.hero-copy{position:relative;z-index:1;padding-top:clamp(100px,14vh,200px)}.hero-copy h1{font-size:clamp(78px,8.8vw,205px);letter-spacing:-.065em;line-height:.97;margin:clamp(30px,5vh,75px) 0 0;max-width:65%}.hero-bottom{margin-top:clamp(35px,5vh,85px);max-width:410px}.hero-bottom p{font-size:clamp(22px,2vw,43px);line-height:1.35;margin:0 0 35px}.arrow-link{display:inline-flex;gap:clamp(28px,3vw,70px);align-items:center;border-bottom:1px solid #292723;padding-bottom:13px}.arrow-link span{font-size:18px}.hero-foot{position:absolute;bottom:34px;left:0;right:0;z-index:1;display:flex;justify-content:space-between;align-items:end}.hero-credit{text-align:right;color:#fff;text-shadow:0 1px 6px #0008;font-size:12px;line-height:1.8}.hero-credit strong{font-weight:600}.intro{padding-block:clamp(100px,11vw,210px) clamp(110px,11vw,220px)}.intro-head{display:flex;justify-content:space-between}.intro h2{font-size:clamp(48px,6vw,125px);letter-spacing:-.055em;line-height:1.08;max-width:1150px;margin:45px 0 85px}.collection-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(16px,2vw,40px)}.collection-card{position:relative;display:block;overflow:hidden;height:clamp(400px,48vw,1000px);background:#dedbd4}.collection-card img{height:100%;width:100%;object-fit:cover;transition:transform .7s ease}.collection-card:hover img{transform:scale(1.045)}.collection-overlay{position:absolute;inset:auto 0 0;padding:clamp(22px,3vw,60px);background:linear-gradient(transparent,#0b0b0bc9);color:#fff;display:flex;flex-direction:column;gap:12px}.collection-overlay strong{font-size:clamp(36px,4.2vw,90px);line-height:1.1}.collection-overlay small{display:flex;justify-content:space-between;font-size:12px;letter-spacing:.06em}.catalog{padding-block:clamp(90px,9vw,170px)}.catalog-head{border-top:1px solid #bdbbb5;padding-top:25px;display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:clamp(45px,6vw,120px)}.catalog-head h2{font-size:clamp(52px,6.4vw,140px);letter-spacing:-.055em;line-height:1.1;margin:20px 0 0}.count{font-family:Manrope,sans-serif;font-size:clamp(12px,1vw,22px);letter-spacing:0;vertical-align:top;margin-left:20px}.art-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:clamp(22px,3.3vw,75px);row-gap:clamp(75px,8vw,180px)}.art-card{border:0;background:transparent;text-align:left;padding:0;color:inherit;min-width:0}.art-card.offset{margin-top:clamp(40px,6vw,120px)}.art-picture{display:block;overflow:hidden;background:#e5e3dc}.art-picture img{display:block;width:100%;height:clamp(300px,32vw,780px);object-fit:contain;transition:transform .6s ease}.art-card:hover img,.art-card:focus-visible img{transform:scale(1.035)}.art-info{display:grid;grid-template-columns:30px 1fr auto;gap:12px;margin-top:22px}.art-info strong{display:block;font-size:clamp(20px,1.6vw,37px);line-height:1.25;letter-spacing:-.03em}.art-info small{display:block;margin-top:8px;font-size:12px;color:#787671}.art-info>.label:last-child{text-align:right;white-space:nowrap}.interlude{display:grid;grid-template-columns:1fr 1fr;min-height:clamp(480px,48vw,920px);background:#e8e7e2}.interlude-image{overflow:hidden}.interlude-image img{width:100%;height:100%;object-fit:cover}.interlude-copy{padding:clamp(50px,7vw,150px);display:flex;flex-direction:column;justify-content:center}.interlude-copy p{font-size:clamp(50px,5vw,110px);line-height:1.15;letter-spacing:-.04em}.about{display:grid;grid-template-columns:1fr 1fr;background:#eae8e2;margin-top:clamp(80px,8vw,180px)}.about-visual{height:clamp(600px,54vw,1050px);overflow:hidden}.about-visual img{width:100%;height:100%;object-fit:cover}.about-text{padding:clamp(55px,8vw,180px);display:flex;flex-direction:column;justify-content:center;align-items:flex-start}.about-text h2,.contact h2{font-size:clamp(60px,6vw,135px);letter-spacing:-.055em;line-height:1.1;margin:45px 0}.about-text>p,.contact-left>p{font-size:clamp(15px,1.1vw,22px);line-height:1.9;max-width:630px}.about-note{color:#77736e;font-size:13px!important}.about-text .arrow-link{margin-top:45px}.contact{padding-block:clamp(120px,12vw,240px);display:grid;grid-template-columns:1fr 1fr;gap:clamp(60px,10vw,210px)}.contact form{display:flex;flex-direction:column;gap:35px;padding-top:55px}.contact form label{font-size:11px;text-transform:uppercase;letter-spacing:.15em;font-weight:600;display:flex;flex-direction:column;gap:14px}.contact input,.contact textarea{background:none;border:0;border-bottom:1px solid #aaa8a1;border-radius:0;padding:12px 0;font-size:16px;outline:none;resize:vertical}.contact input:focus,.contact textarea:focus{border-bottom-color:#111}.submit{border:0;border-bottom:1px solid #181817;background:none;display:flex;justify-content:space-between;padding:20px 0}.submit span{font-size:20px}.success{font-size:13px}.footer{min-height:130px;border-top:1px solid #cccac4;display:flex;align-items:center;justify-content:space-between;gap:20px}.footer>span{font-size:11px;color:#777}dialog{padding:0;border:0;width:min(1500px,94vw);max-width:94vw;max-height:92vh;background:#f7f6f2;color:#181817}dialog::backdrop{background:#080808df}.viewer-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(250px,.8fr);min-height:650px}.viewer-image{background:#e7e5df;display:grid;place-items:center;padding:clamp(20px,4vw,65px)}.viewer-image img{max-height:80vh;width:100%;height:auto;object-fit:contain}.viewer-text{padding:clamp(45px,6vw,100px);display:flex;flex-direction:column;justify-content:center}.viewer-text h2{font-size:clamp(40px,4vw,85px);letter-spacing:-.04em;line-height:1.1}.viewer-text p{color:#777}.viewer-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:70px}.viewer-buttons{display:flex;gap:15px}.viewer-buttons button,.close{border:0;background:none;font-size:28px}.close{position:absolute;right:20px;top:12px;z-index:2}@media(min-width:2300px){.hero-image{left:36%}.hero-copy h1{font-size:clamp(160px,7.5vw,260px)}.art-picture img{height:clamp(600px,29vw,950px)}}@media(max-width:1050px){.hero-copy h1{font-size:clamp(70px,9vw,120px)}.art-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.art-info{grid-template-columns:22px 1fr}.art-info>.label:last-child{grid-column:2;text-align:left}.about-text{padding:60px}.contact{gap:50px}}@media(max-width:700px){.header{height:95px;flex-wrap:wrap;align-content:center;gap:14px}.brand{font-size:11px}.header nav{order:3;width:100%;justify-content:space-between;gap:8px}.header nav a{font-size:10px}.hero{height:740px;min-height:0}.hero-image{inset:33% 0 0 0}.hero-image img{object-position:center 35%}.hero-wash{background:linear-gradient(#f7f6f2 0%,#f7f6f2 26%,#f7f6f2c9 37%,transparent 60%)}.hero-copy{padding-top:65px}.hero-copy h1{font-size:clamp(62px,13vw,100px);max-width:100%;margin-top:25px}.hero-bottom{margin-top:25px;max-width:250px}.hero-bottom p{font-size:22px;margin-bottom:22px}.hero-foot{bottom:20px}.hero-credit{font-size:10px}.intro{padding-block:85px}.intro h2{font-size:47px;margin:28px 0 40px}.collection-grid{grid-template-columns:1fr}.collection-card{height:470px}.collection-overlay strong{font-size:45px}.catalog{padding-block:80px}.catalog-head{align-items:start;flex-direction:column}.catalog-head h2{font-size:clamp(45px,10vw,70px)}.art-grid{grid-template-columns:1fr;row-gap:60px}.art-card.offset{margin-top:0}.art-picture img{height:440px}.art-info strong{font-size:27px}.interlude{grid-template-columns:1fr}.interlude-image{height:440px}.interlude-copy{padding:65px 28px}.interlude-copy p{font-size:55px}.about{grid-template-columns:1fr}.about-visual{height:450px}.about-text{padding:80px 28px}.about-text h2,.contact h2{font-size:65px}.contact{grid-template-columns:1fr;gap:20px;padding-block:100px}.contact form{padding-top:10px}.footer{padding-block:30px;flex-wrap:wrap;min-height:0}.footer>span{order:3;width:100%}.viewer-grid{grid-template-columns:1fr;min-height:0}.viewer-image{padding:50px 20px 20px}.viewer-image img{max-height:45vh}.viewer-text{padding:20px 25px 40px}.viewer-text h2{font-size:35px;margin:15px 0}.viewer-bottom{margin-top:20px}}
</style>
